# -----------------------------------------------------------------------------
# Local sandbox settings. Docker Compose reads this file automatically and
# substitutes ${VAR} references in docker-compose.yml.
#
# These are throwaway credentials for a laptop sandbox. Never reuse them, and
# never commit a real .env with real secrets to git.
# -----------------------------------------------------------------------------

# Project name prefixes container, network and volume names.
COMPOSE_PROJECT_NAME=desandbox

# --- Source database (the "production" OLTP system we sync FROM) -------------
SOURCE_DB_USER=shop
SOURCE_DB_PASSWORD=shop
SOURCE_DB_NAME=shop
# Exposed on the host so you can poke at it with psql / a GUI.
SOURCE_DB_HOST_PORT=5433

# --- Change generator ---------------------------------------------------------
# Every CHANGE_INTERVAL_SECONDS the generator inserts CHANGE_INSERTS new orders
# and updates CHANGE_UPDATES random existing ones.
CHANGE_INTERVAL_SECONDS=5
CHANGE_INSERTS=10
CHANGE_UPDATES=25

# --- Airflow metadata database (Airflow's own state, NOT the source data) ----
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Airflow ------------------------------------------------------------------
# UID the Airflow containers run as. On Linux set this to `id -u` so files the
# containers write into ./logs are owned by you. 50000 is the image default.
AIRFLOW_UID=50000
# Fernet key encrypts connection passwords in the metadata DB. Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
# Shared secret the Airflow components use to sign/verify JWTs for the
# Task Execution API (Airflow 3). Every component must use the same value.
AIRFLOW_JWT_SECRET=sandbox-jwt-secret-change-me
AIRFLOW_HOST_PORT=8080

# --- Object storage (RustFS, S3-compatible) -----------------------------------
# RustFS root credentials; they double as the S3 access key / secret key.
S3_ACCESS_KEY=sandbox-access-key
S3_SECRET_KEY=sandbox-secret-key
S3_REGION=us-east-1
WAREHOUSE_BUCKET=warehouse
RUSTFS_API_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001

# --- Iceberg REST catalog -----------------------------------------------------
ICEBERG_REST_HOST_PORT=8181

# --- Spark --------------------------------------------------------------------
SPARK_MASTER_UI_HOST_PORT=8090
# Per-worker resources. 2 workers x (2 cores, 2 GB) fits on a 16 GB laptop.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
